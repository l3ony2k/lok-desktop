#!/bin/sh
# Editor used by nnn (via $VISUAL in n()): inside tmux, zoom nnn's pane so the
# editor gets the full window, then restore the preview split on exit.
zoomed=
if [ -n "$TMUX" ] && [ "$(tmux display -p -t "$TMUX_PANE" '#{window_panes}')" -gt 1 ] \
    && [ "$(tmux display -p -t "$TMUX_PANE" '#{window_zoomed_flag}')" = 0 ]; then
    tmux resize-pane -Z -t "$TMUX_PANE" && zoomed=1
fi
"${EDITOR:-vim}" "$@"
status=$?
[ -n "$zoomed" ] && tmux resize-pane -Z -t "$TMUX_PANE"
exit $status
