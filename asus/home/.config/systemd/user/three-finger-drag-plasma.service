# 2026-11-12: three-finger drag for Plasma only (KWin has no 3fg-drag setting).
# The daemon grabs the real touchpad and re-emits it as a virtual one, so it must
# NOT run under Hyprland (its own drag_3fg + the elan-touchpad accel curve would be
# bypassed). Hence a user unit wanted only by plasma-workspace.target, stopped with
# the graphical session. The packaged system unit three-finger-drag.service stays disabled.
[Unit]
Description=Three-finger drag (Plasma session only)
Documentation=https://github.com/lmr97/linux-3-finger-drag
PartOf=graphical-session.target
After=plasma-kwin_wayland.service

[Service]
Type=exec
ExecStart=/usr/bin/linux-3-finger-drag
Restart=on-failure
RestartSec=1

[Install]
WantedBy=plasma-workspace.target
