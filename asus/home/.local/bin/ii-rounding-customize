#!/usr/bin/env python3
"""Keep Quickshell's Appearance.qml rounding in sync with the Hyprland gaps.

Values (invariant: screenRounding - hyprlandGapsOut + 1 == windowRounding):
  screenRounding = 13, windowRounding = 11, hyprlandGapsOut = 3
Hyprland itself must have decoration.rounding = 11 and gaps_out = 3; this
script only reports a mismatch there (edit custom/general.lua instead).
"""
import argparse
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

HOME = Path.home()
APPEARANCE = HOME / '.config/quickshell/ii/modules/common/Appearance.qml'
SHELL = HOME / '.config/quickshell/ii/shell.qml'
BACKUP = HOME / '.local/state/ii-customizations/backups'
WANT = {'screenRounding': 13, 'windowRounding': 11, 'hyprlandGapsOut': 3}


def patterns():
    return {
        'screenRounding': (r'property int screenRounding:\s*[^\s/]+(?:[^\n]*)',
                           'property int screenRounding: 13 // screenRounding - hyprlandGapsOut + 1 == windowRounding'),
        'windowRounding': (r'property int windowRounding:\s*\S+', 'property int windowRounding: 11'),
        'hyprlandGapsOut': (r'property real hyprlandGapsOut:\s*\S+', 'property real hyprlandGapsOut: 3'),
    }


def current_values(text):
    values = {}
    for key in WANT:
        match = re.search(rf'property (?:int|real) {key}:\s*([0-9]+)', text)
        values[key] = int(match.group(1)) if match else None
    return values


def hyprland_option(name):
    try:
        out = subprocess.check_output(['hyprctl', 'getoption', name], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    match = re.search(r'(?:int|css gap data):\s*(\d+)', out)
    return int(match.group(1)) if match else None


def check(text):
    problems = []
    values = current_values(text)
    for key, want in WANT.items():
        if values[key] != want:
            problems.append(f'{APPEARANCE}: {key} = {values[key]} (want {want})')
    checks = {
        'decoration:rounding': 11,
        'general:gaps_out': 3,
        'general:gaps_in': 2,
    }
    for option, want in checks.items():
        got = hyprland_option(option)
        if got is not None and got != want:
            problems.append(f'hyprctl {option} = {got} (want {want}; edit custom/general.lua)')
    return problems


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='report drift, change nothing')
    args = parser.parse_args()
    text = APPEARANCE.read_text()
    problems = check(text)
    if args.check:
        print('\n'.join(problems) if problems else 'rounding in sync')
        return 1 if problems else 0
    changed = False
    for key, (pattern, replacement) in patterns().items():
        new_text = re.sub(pattern, replacement, text)
        if new_text != text:
            text = new_text
            changed = True
    if changed:
        stamp = datetime.now().strftime('%Y%m%d-%H%M%S')
        backup = BACKUP / stamp / 'modules/common'
        backup.mkdir(parents=True, exist_ok=True)
        shutil.copy2(APPEARANCE, backup / 'Appearance.qml')
        APPEARANCE.write_text(text)
        if SHELL.exists():
            SHELL.touch()
        print('applied; backup:', backup.parent)
    else:
        print('already in sync')
    # Hyprland values are only reportable; do not silently rewrite custom/general.lua.
    hyprland_problems = [p for p in problems if p.startswith('hyprctl')]
    if hyprland_problems:
        print('\n'.join(hyprland_problems))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
