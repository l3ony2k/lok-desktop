#!/bin/bash
# ii-restart — restart the ii Quickshell config only if it will load (lok task, 2026-11-15).
# Replaces the dots' Ctrl+Super+R `killall qs; qs -c ii &`, which turned one bad QML file into
# "no bar". Live reload already keeps the old config when an edit fails to load; only a cold
# restart throws the working instance away, so this gate sits in front of it.
#
# 1. qmllint the QML files changed since the last successful start (all files the first time),
#    blocking only on what makes the config fail to load: [syntax] errors, properties that
#    shadow a FINAL base member, and a missing import of one of ii's own components ("LokFrame
#    was not found" while LokFrame.qml exists in ii). Quickshell's native types are unresolvable
#    to qmllint and are ignored; existing hits are in a baseline (--baseline rebuilds it).
#    On a hit: notify, print, exit 1, and leave the running shell alone.
# 2. killall -w (wait until the old instance is gone, so two never overlap), start a new one.
# 3. Report whether it came up.
#   ii-restart            check + restart
#   ii-restart --check    check only (all files)
#   ii-restart --force    restart without the check
#   ii-restart --baseline record today's "own component not found" hits as accepted
set -u
CFG=${II_CONFIG:-ii}
DIR="$HOME/.config/quickshell/$CFG"
STAMP="$HOME/.cache/ii-restart.stamp"
LINT=/usr/lib/qt6/bin/qmllint
BASE="$HOME/.cache/ii-restart.import-baseline"
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)}

say() { echo "$1: $2" >&2; notify-send -a ii-restart "$1" "$2" 2>/dev/null || true; }

check() { # $1 = all|changed
    local files
    if [ "$1" = all ] || [ ! -f "$STAMP" ]; then files=$(find "$DIR" -name '*.qml')
    else files=$(find "$DIR" -name '*.qml' -newer "$STAMP"); fi
    [ -z "$files" ] && return 0
    [ -x "$LINT" ] || { echo "qmllint not found; skipping check" >&2; return 0; }
    local out bad own
    out=$(echo "$files" | tr '\n' '\0' | xargs -0 -P8 -n40 "$LINT" -I "$DIR" 2>&1 | sed "s|$DIR/||")
    own=$(find "$DIR" -name '*.qml' -printf '%f\n' | sed 's/\.qml$//' | sort -u)
    bad=$( { echo "$out" | grep -E '\[syntax\]|shadows final member'
             echo "$out" | grep -E 'was not found\. Did you add all imports' | while IFS= read -r l; do
                 t=$(echo "$l" | sed -E 's/.*: ([A-Za-z0-9_]+) was not found.*/\1/')
                 f=$(echo "$l" | sed -E 's/^Warning: ([^:]+):.*/\1/')
                 echo "$own" | grep -qx "$t" || continue
                 grep -qx "$f $t" "$BASE" 2>/dev/null && continue
                 echo "$l"
             done; } )
    [ -z "$bad" ] && return 0
    echo "$bad" >&2
    say "Quickshell not restarted" "$(echo "$bad" | head -3 | cut -c1-160)"
    return 1
}

baseline() {
    find "$DIR" -name '*.qml' -print0 | xargs -0 -P8 -n40 "$LINT" -I "$DIR" 2>&1 | sed "s|$DIR/||" \
        | grep -E 'was not found\. Did you add all imports' \
        | sed -E 's/^Warning: ([^:]+):[0-9]+:[0-9]+: ([A-Za-z0-9_]+) was not found.*/\1 \2/' | sort -u > "$BASE"
    echo "baseline: $(wc -l < "$BASE") file/type pairs"
}

case "${1:-}" in
    --baseline) baseline; exit 0 ;;
    --check) check all; exit $? ;;
    --force) ;;
    *) check changed || exit 1 ;;
esac

killall ydotool 2>/dev/null
timeout 5 killall -w qs quickshell 2>/dev/null || killall -9 qs quickshell 2>/dev/null
hyprctl -q eval "hl.exec_cmd(\"qs -c $CFG\")"
for _ in 1 2 3 4 5 6 7 8; do sleep 1; pgrep -x qs >/dev/null && break; done
sleep 2
if pgrep -x qs >/dev/null; then touch "$STAMP"; echo "qs running pid=$(pgrep -x qs)"
else echo "qs did not start" >&2; exit 2; fi
