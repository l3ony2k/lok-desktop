@@ -563,11 +573,34 @@ impl GestureMachine {
     /// release it to the compositor as an ordinary gesture.
     fn resolve_touch_decision(&mut self, count: usize, now: Instant, out: &mut Vec<Output>) {
         if count == 3 && self.touch_max == 3 {
-            self.pending.clear();
             let active = self.active_slots();
+            // Local patch: three resting fingers are a tap until they move.
+            // If they lift inside TAP_WINDOW without moving, the count == 0
+            // path flushes the buffered touch and libinput sees a 3-finger
