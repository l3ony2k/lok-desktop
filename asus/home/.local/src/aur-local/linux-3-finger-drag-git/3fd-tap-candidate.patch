+                let dy = (self.slots[s0].y - oy) as f64 / self.y_res;
+                let moved = (dx * dx + dy * dy).sqrt() >= TAP_MOVE_MM;
+                if !moved && now < start + TAP_WINDOW {
+                    return; // keep buffering: still a possible tap
+                }
