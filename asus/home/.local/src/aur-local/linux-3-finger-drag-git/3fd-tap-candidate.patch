+            if let Some(start) = self.touch_start {
+                let s0 = active[0];
+                let (ox, oy) = match self.tap_origin {
+                    Some((slot, x, y)) if slot == s0 => (x, y),
+                    _ => {
+                        let o = (self.slots[s0].x, self.slots[s0].y);
+                        self.tap_origin = Some((s0, o.0, o.1));
