#!/bin/bash
# Mirror a remote step to the on-screen live log (/tmp/claude-live.log).
# usage: claude-step "说明" command [args...]
log=/tmp/claude-live.log
[ -e $log ] || { : > $log; chmod 666 $log; }
desc=$1; shift
{ echo; echo "━━━ $(date +%T)  $desc"; printf "\$ %s\n" "$*"; } >> $log
"$@" 2>&1 | tee -a $log
exit ${PIPESTATUS[0]}
