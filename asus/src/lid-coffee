#!/bin/sh
# lid-coffee — lid handler that respects the Quickshell coffee (idle inhibit) toggle.
# 2026-11-08, see asus-arch-ops entry "coffee keeps the machine awake, lid included".
#
# Coffee on : Quickshell holds a logind handle-lid-switch inhibitor, so logind does
#             not suspend. On close: lock the session (input goes to the lock screen)
#             and turn the panel off. Programs keep running.
# Coffee off: logind suspends (then hibernates after 3 h) as usual; nothing to do on close.
# Open      : turn the panel back on (harmless when it is already on).
#
# Bound in ~/.config/hypr/custom/keybinds.lua (switch:on/off:Lid Switch, locked).

coffee_on() {
    systemd-inhibit --list --no-legend 2>/dev/null | grep -q "Quickshell coffee.*handle-lid-switch"
}

case "$1" in
    close)
        coffee_on || exit 0
        loginctl lock-session
        sleep 1
        hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null
        ;;
    open)
        hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null
        ;;
    *)
        echo "usage: lid-coffee close|open" >&2
        exit 2
        ;;
esac
