# Local package for this ASUS CX54 (SCREEBO) Chromebook: rust-fp for the ChromeOS
# FPMCU (/dev/cros_fp, bloonchipper, FPC sensor).
# Source: kaukauk/rust-fp @ cadbe52 (fork of ChocolateLoverRaj/rust-fp) built from
# ~/Projects/rust-fp-sandbox/src, with crosec-rs patched for EC_CMD_FP_INFO v2
# (newer FPMCU firmware v2.0.30778 dropped v1). See asus-arch-ops entries.
# The safe sudo PAM module (pam_rust_fp_safe.so) is built from ../pam-safe.
pkgname=rust-fp-cros-local
pkgver=1.0.0
pkgrel=3
pkgdesc="rust-fp fingerprint daemon + CLI for ChromeOS FPMCU, FP_INFO v2 patch, safe PAM module"
arch=('x86_64')
url="https://github.com/kaukauk/rust-fp"
license=('custom:unknown')
depends=('pam' 'systemd-libs' 'dbus')
provides=('rust-fp-cros')
conflicts=('rust-fp-cros')
source=()
_sb=/home/leon/Projects/rust-fp-sandbox

package() {
  install -Dm755 "$_sb/src/target/release/rust-fp"                "$pkgdir/usr/bin/rust-fp"
  install -Dm755 "$_sb/src/target/release/rust-fp-dbus-interface" "$pkgdir/usr/bin/rust-fp-dbus-interface"
  install -Dm644 "$_sb/src/dbus-interface/org.rust_fp.RustFp.conf" \
    "$pkgdir/usr/share/dbus-1/system.d/org.rust_fp.RustFp.conf"
  install -Dm644 "$_sb/src/packaging/rust-fp-dbus-interface.service" \
    "$pkgdir/usr/lib/systemd/system/rust-fp-dbus-interface.service"
  if [ -f "$_sb/src/target/release/libpam_rust_fp_safe.so" ]; then
    install -Dm755 "$_sb/src/target/release/libpam_rust_fp_safe.so" \
      "$pkgdir/usr/lib/security/pam_rust_fp_safe.so"
  fi
  if [ -f "$_sb/pam-safe/rust-fp-has-templates" ]; then
    install -Dm755 "$_sb/pam-safe/rust-fp-has-templates" "$pkgdir/usr/bin/rust-fp-has-templates"
  fi
}
