+/// A match call starting later than this after the previous one is a new
+/// wait, not the re-poll of an ongoing one (re-polls come every
+/// MATCH_STEP_TIMEOUT = 2 s). Stale-match fix.
+const STALE_GAP: Duration = Duration::from_millis(2500);
+
 impl OpenedCrosFp {
+    /// Take the sensor out of match mode and throw away queued fingerprint
+    /// events (stale-match fix).
+    async fn disarm_and_drain(&mut self) -> anyhow::Result<()> {
+        let mode = fp_mode(&mut self.file, FpMode::DontChange as u32)
+            .map_err(|e| anyhow::anyhow!("Error reading fp mode: {e:?}"))?;
+        if mode & FpMode::Match as u32 != 0 {
+            fp_mode(&mut self.file, FpMode::Reset as u32)
+                .map_err(|e| anyhow::anyhow!("Error doing Reset: {e:?}"))?;
+        }
+        for _ in 0..32 {
+            let queued = wait_event_timeout(
+                &mut self.file,
+                [EcMkbpEventType::Fingerprint, EcMkbpEventType::HostEvent],
+                Duration::ZERO,
+            )
+            .await?;
+            if queued.is_none() {
+                break;
+            }
+        }
+        Ok(())
+    }
+
