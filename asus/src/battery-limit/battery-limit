#!/bin/bash
# battery-limit — ChromeOS EC charge limit (ASUS CX54 / SCREEBO). 2026-11-12.
#
#   battery-limit status          key=value: limit start current capacity status saved
#   battery-limit set 60|80|100   apply now and save as the boot value
#   battery-limit cycle           60 -> 80 -> 100 -> 60 (for the ii quick toggle)
#   battery-limit apply           write the saved value (boot: battery-charge-threshold.service)
#
# The EC forgets the limit on every boot, so the saved value lives in
# /etc/battery-charge-limit and is re-applied at boot. Charging resumes 5 points
# below the limit (start threshold); 100 means no limit (start 95).
# Called unprivileged through `sudo -n` (sudoers: /etc/sudoers.d/battery-limit).
# Plasma's own charge-limit setting writes the same sysfs files but is not saved:
# after a reboot the value from this file wins.
set -u
B=/sys/class/power_supply/BAT0
CONF=/etc/battery-charge-limit
ALLOWED="60 80 100"
DEFAULT=80

saved() {
  local v
  v=$(tr -dc '0-9' < "$CONF" 2>/dev/null)
  case " $ALLOWED " in *" $v "*) echo "$v" ;; *) echo "$DEFAULT" ;; esac
}

wait_sysfs() {
  for _ in $(seq 1 30); do
    [ -w "$B/charge_control_end_threshold" ] && return 0
    sleep 1
  done
  echo "BAT0 charge threshold attributes never appeared" >&2
  return 1
}

write_limit() {
  local end=$1 start=$(( $1 - 5 )) cur
  cur=$(cat "$B/charge_control_end_threshold")
  # Keep start < end at every step: raise end first, or lower start first.
  if [ "$end" -ge "$cur" ]; then
    echo "$end" > "$B/charge_control_end_threshold" || return 1
    echo "$start" > "$B/charge_control_start_threshold" || return 1
  else
    echo "$start" > "$B/charge_control_start_threshold" || return 1
    echo "$end" > "$B/charge_control_end_threshold" || return 1
  fi
}

need_root() { [ "$(id -u)" = 0 ] || { echo "must run as root (via sudo)" >&2; exit 1; }; }

case "${1:-status}" in
  status)
    echo "limit=$(cat $B/charge_control_end_threshold 2>/dev/null)"
    echo "start=$(cat $B/charge_control_start_threshold 2>/dev/null)"
    echo "saved=$(saved)"
    echo "capacity=$(cat $B/capacity 2>/dev/null)"
    echo "status=$(cat $B/status 2>/dev/null)"
    echo "current=$(cat $B/current_now 2>/dev/null)"
    echo "ac=$(cat /sys/class/power_supply/AC/online 2>/dev/null)"
    ;;
  set)
    need_root
    v=${2:-}
    case " $ALLOWED " in *" $v "*) ;; *) echo "usage: battery-limit set 60|80|100" >&2; exit 2 ;; esac
    wait_sysfs || exit 1
    write_limit "$v" || { echo "EC rejected limit $v" >&2; exit 1; }
    echo "$v" > "$CONF"
    "$0" status
    ;;
  cycle)
    need_root
    case "$(saved)" in 60) n=80 ;; 80) n=100 ;; *) n=60 ;; esac
    exec "$0" set "$n"
    ;;
  apply)
    need_root
    wait_sysfs || exit 1
    v=$(saved)
    write_limit "$v" || exit 1
    echo "charge thresholds: start=$(cat $B/charge_control_start_threshold) end=$(cat $B/charge_control_end_threshold)"
    ;;
  *)
    echo "usage: battery-limit status | set 60|80|100 | cycle | apply" >&2
    exit 2
    ;;
esac
