+            let queued = wait_event_timeout(
+                &mut self.file,
+                [EcMkbpEventType::Fingerprint, EcMkbpEventType::HostEvent],
+                Duration::ZERO,
+            )
+            .await?;
+            if queued.is_none() {
+                break;
+            }
+        }
+        Ok(())
+    }
