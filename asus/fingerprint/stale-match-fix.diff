 impl OpenedCrosFp {
+    /// Take the sensor out of match mode and throw away queued fingerprint
+    /// events (stale-match fix).
+    async fn disarm_and_drain(&mut self) -> anyhow::Result<()> {
+        let mode = fp_mode(&mut self.file, FpMode::DontChange as u32)
+            .map_err(|e| anyhow::anyhow!("Error reading fp mode: {e:?}"))?;
+        if mode & FpMode::Match as u32 != 0 {
+            fp_mode(&mut self.file, FpMode::Reset as u32)
+                .map_err(|e| anyhow::anyhow!("Error doing Reset: {e:?}"))?;
+        }
